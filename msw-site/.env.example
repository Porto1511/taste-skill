# ---------------------------------------------------------------------------
# MSW Site configuration.
# With NONE of the Supabase values set, the app runs in DEMO MODE:
#   embedded Postgres (PGlite) in ./.data, local password sessions, private
#   on-disk file storage, simulated invite emails.
# Set ALL FOUR Supabase values to run in SUPABASE (production) MODE.
# ---------------------------------------------------------------------------

# Public project URL and anon key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for Storage and inviting users.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — Postgres connection string (Supabase "Connection string",
# transaction pooler, port 6543, is fine). Queries run as role `authenticated`.
DATABASE_URL=

# Optional
# SUPABASE_STORAGE_BUCKET=msw-private
# NEXT_PUBLIC_SITE_URL=https://site.msw.example         # used in invite/reset links
# NEXT_PUBLIC_MSW_OFFICE_PHONE=07700 900100             # shown to operatives with no jobs
# MSW_MODE=demo|supabase                                # force a mode
# MSW_DATA_DIR=./.data                                  # demo database + files
# MSW_SECURE_COOKIES=1                                  # demo: force Secure cookies
# LOG_LEVEL=info
